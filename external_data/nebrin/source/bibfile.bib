@article{Slocomb1971,
    author = {Slocomb, C. A. and Miller, W. H. and Schaefer, H. F., III},
    title = "{Collisional Quenching of Metastable Hydrogen Atoms}",
    journal = {The Journal of Chemical Physics},
    volume = {55},
    number = {2},
    pages = {926-932},
    year = {1971},
    month = {07},
    abstract = "{Quenching of metastable hydrogen atoms by low energy collisions with atoms and molecules is considered, the actual process being H(2s)+X→H(2p)+X. The Born approximation, with long‐range multipole–multipole interactions, is used to describe collisions of H(2s) with molecules, and simple formulas for the cross section result. Collisions with spherically symmetric species (i.e., rare gas atoms) are treated in the adiabatic approximation, and the process is seen to be formally identical to symmetric charge transfer. Numerical results for collisional quenching by helium, based on accurately computed potential curves, are presented.}",
    issn = {0021-9606},
    doi = {10.1063/1.1676163},
